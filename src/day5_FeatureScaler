class FeatureScaler:

    def __init__(self, data):
        self.data = data
        self.scaled_data = None

    # Step 6: Input Validation
    def validate_input(self):
        if not isinstance(self.data, list):
            raise ValueError("Input must be a list.")

        if len(self.data) == 0:
            raise ValueError("Input list cannot be empty.")

        for value in self.data:
            if not isinstance(value, (int, float)):
                raise ValueError("Dataset contains invalid values.")

    # Step 7: Find Minimum
    def find_minimum(self):
        minimum = self.data[0]

        for value in self.data:
            if value < minimum:
                minimum = value

        return minimum

    # Step 8: Find Maximum
    def find_maximum(self):
        maximum = self.data[0]

        for value in self.data:
            if value > maximum:
                maximum = value

        return maximum

    # Step 9: Scale Data
    def scale_data(self):

        minimum = self.find_minimum()
        maximum = self.find_maximum()

        # Step 10: Handle Constant Data
        if minimum == maximum:
            raise ValueError(
                "Cannot scale data because all values are identical."
            )

        self.scaled_data = []

        for value in self.data:
            scaled_value = (value - minimum) / (maximum - minimum)
            self.scaled_data.append(scaled_value)

        return self.scaled_data

    # Step 12: Display Report
    def display_report(self):

        minimum = self.find_minimum()
        maximum = self.find_maximum()
        scaled_data = self.scale_data()

        print("========================================")
        print("         FEATURE SCALING REPORT")
        print("========================================")

        print("Original Data :", self.data)
        print("Minimum :", minimum)
        print("Maximum :", maximum)
        print("Scaled Data :", scaled_data)

        print("========================================")


# Step 13: Main Function
def main():

    # Step 14: Dataset
    data = [10, 20, 30, 40, 50]

    try:

        # Step 15: Create Object
        obj = FeatureScaler(data)

        # Step 16: Validate
        obj.validate_input()

        # Step 17: Generate Report
        obj.display_report()

    except ValueError as error:
        print("Error:", error)


# Step 19: Program Entry Point
if __name__ == "__main__":
    main()